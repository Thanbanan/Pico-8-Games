--the game
current_level = 1
copies = {}
x = 60
y = 112
spawn_x = 60  -- default spawn x
spawn_y = 112 -- default spawn y
vy = 0 
gravity = 0.5
jump_force = -6
is_grounded = false
game_over = false
deaths = 0
frames = 0
not_start = true

cls(0)

function _init()
	while(not_start == true)do
		print("red square", 42,10,12)
		print("blue face", 44,20,12)
	 spr(8,30,25,8,8)
		print("z to start", 43,90,12)
		if(btn(4)) then
			not_start = false
		end
	end
 load_level(current_level)
end


function load_level(num)
 copies = {}  
 
 spawn_x = 60
 spawn_y = 112
 
 local map = levels[num]
 for row = 1, #map do
  local line = map[row]
  for col = 1, #line do
   local char = sub(line, col, col)
   local tx = (col - 1) * 8 - 8
   local ty = (row - 1) * 8
   
   if char == "1" then add(copies, {x = tx, y = ty, spr = 1})
   elseif char == "3" then add(copies, {x = tx, y = ty, spr = 3})
   elseif char == "4" then add(copies, {x = tx, y = ty, spr = 4})
   elseif char == "5" then add(copies, {x = tx, y = ty, spr = 5})
   elseif char == "6" then 
    
    spawn_x = tx
    spawn_y = ty
    
    add(copies, {x = tx, y = ty, spr = 6})
   end
  end
 end
 
 
 reset_player()
end


function win_level()
 if current_level < #levels then
  current_level += 1
  load_level(current_level)
  sfx(1)
 else
  game_over = true 
 end
end

function reset_player()
 x = spawn_x
 y = spawn_y
 vy = 0
 is_grounded = false
 
end

function _update()
 if (game_over) return
	

 local dx = 0
 if(btn(0)) then dx -= 5 end
 if(btn(1)) then dx += 5 end
 
 x += dx
 
 for c in all(copies) do
  if x + 8 > c.x and x < c.x + 8 and y + 8 > c.y and y < c.y + 8 then
   if c.spr == 5 then
    reset_player()
    deaths = deaths + 1
    sfx(0)
   elseif c.spr == 4 then
    win_level()
    return 
   elseif c.spr != 6 then -- ignore solid collision for spawn points
    if dx > 0 then x = c.x - 8 end
    if dx < 0 then x = c.x + 8 end
   end
  end
 end
 
 
 if(btn(5) and is_grounded) then
  vy = jump_force
  is_grounded = false
 end
 
 
 vy += gravity
 y += vy
 
 is_grounded = false
 for c in all(copies) do
  if x + 8 > c.x and x < c.x + 8 and y + 8 > c.y and y < c.y + 8 then
   if c.spr == 5 then
    reset_player()
    deaths = deaths + 1
    sfx(0)
   elseif c.spr == 4 then
    win_level()
    return
   elseif c.spr != 6 then -- ignore solid collision for spawn points
    if vy >= 0 then 
     y = c.y - 8 
     vy = 0
     is_grounded = true
    elseif vy < 0 then 
     y = c.y + 8 
     vy = 0
    end
   end
   
  end
 end
end

function _draw()
 cls(12)
 if(y>112)then
 		reset_player()
 		deaths = deaths+1
 		sfx(0)
 end
 
 for c in all(copies) do
  spr(c.spr, c.x, c.y)
 end
 
 if not game_over then
 	frames = frames+1
  spr(2, x, y)
  print("level " .. current_level, 4, 4, 7)
 else
 	cls(0)
  print("game complete!", 36, 60, 9)
 	print("you died, "..deaths.." times",30,70,9)
		print("finishing in, ",0,0,9)
		print(frames.." frames!",0,6,9)
 	print("play again?(z)",36,80,9)
 	if(btn(4)) then
 		current_level = 1
 		game_over = false
 		frames = 0
 		deaths = 0
 		load_level(current_level)
 		reset_player()
 	end
 end
end
